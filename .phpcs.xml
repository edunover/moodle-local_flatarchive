<?xml version="1.0"?>
<!--
    PHP CodeSniffer configuration for local_flatarchive.
    Run from plugin root: phpcs . or vendor/bin/phpcs .
    Install: composer global require moodlehq/moodle-cs
    Then: phpcs --standard=moodle local/flatarchive/
-->
<ruleset name="local_flatarchive">
    <description>Moodle coding style for local_flatarchive</description>
    <rule ref="moodle"/>
    <file>.</file>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/style/moodle.css</exclude-pattern>
    <exclude-pattern>*/js/*</exclude-pattern>
    <exclude-pattern>*/templates/*.mustache</exclude-pattern>
</ruleset>
