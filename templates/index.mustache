<div class="local-flatarchive" data-courseid="{{courseid}}">
  <div class="d-flex flex-wrap gap-2 mb-3">
    <button type="button" class="btn btn-outline-secondary" data-action="selectall">{{selectall}}</button>
    <button type="button" class="btn btn-outline-secondary" data-action="deselectall">{{deselectall}}</button>
  </div>

  <div class="card mb-3">
    <div class="card-body">
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <h3 class="h5 mb-0">{{archiveselection}}</h3>
        <div class="d-flex gap-2">
          <button type="button" class="btn btn-primary" data-action="start-archive">{{archiveselection}}</button>
          <a class="btn btn-outline-primary disabled" href="#" data-action="download" aria-disabled="true">{{downloadzip}}</a>
        </div>
      </div>

      <div class="mt-3">
        <div class="small text-muted" data-region="status">{{status_idle}}</div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <div class="small text-muted mb-2 flatarchive-loading" data-region="loading">{{loading}}...</div>
      <div data-region="tree"></div>
    </div>
  </div>
</div>

<style>
  .local-flatarchive .fa-section-title {
    font-weight: 700;
    margin-top: 1rem;
    margin-bottom: .5rem;
    display: flex;
    align-items: center;
    gap: .5rem;
  }
  .local-flatarchive .fa-item {
    display: flex;
    align-items: center;
    gap: .5rem;
    padding: .35rem 0;
  }
  .local-flatarchive .fa-item input[type="checkbox"] {
    transform: translateY(1px);
  }
</style>
